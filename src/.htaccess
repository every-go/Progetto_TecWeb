# 1. Gestione Errori Personalizzata
ErrorDocument 500 /500.php
ErrorDocument 404 /404.php
ErrorDocument 401 /401.php

# 2. SICUREZZA: Blocca l'accesso alla cartella DB
# Nota: <Directory> non funziona nei file .htaccess, si usa RewriteRule
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^DB/ - [F,L]
</IfModule>

# 3. Blocca l'accesso diretto ai file .sql ovunque siano
<FilesMatch "\.(sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Proteggi il file .htaccess stesso
<Files ~ "^\.ht">
    Order allow,deny
    Deny from all
</Files>
